# Copy to .env and fill in. .env is gitignored - never commit your key.

ANTHROPIC_API_KEY=

# Model used across labs 2-8. Sonnet is the sensible default for a workshop:
# capable enough for multi-step tool use, cheap enough not to think about it.
# Check https://platform.claude.com/docs for current model IDs.
WORKSHOP_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Local model server (labs 1 and 2b). The labs auto-detect which is running.
# ---------------------------------------------------------------------------

# llama.cpp / llama-server - the host's GPU machine.
# This is whatever port your start script uses.
LOCAL_API_BASE=http://localhost:8080

# Ollama - more likely on the friends' laptops. Only used when LOCAL_API_BASE
# is NOT set. If you set LOCAL_API_BASE, that address is the only one tried.
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL_SMALL=llama3.2:3b
LOCAL_MODEL_MID=qwen3:8b
LOCAL_MODEL_LARGE=qwen3:14b

# ---------------------------------------------------------------------------
# Optional: any OpenAI-compatible provider, hosted or local
# ---------------------------------------------------------------------------
# Leave LOCAL_API_KEY empty for a local server on your own machine - nothing
# needs a key there, and no auth header is sent.
#
# Set it to point the local-model labs at a hosted provider instead. Useful if
# someone has their own account elsewhere, and it makes Lab 9's harness drive
# two different providers, which is the lesson of that lab made concrete.
#
#   LOCAL_API_BASE=https://api.openai.com      LOCAL_API_KEY=sk-...
#   LOCAL_API_BASE=https://api.groq.com/openai LOCAL_API_KEY=gsk_...
#   LOCAL_MODEL=gpt-4o-mini                    # else the first one listed
#
# This is a SEPARATE variable from ANTHROPIC_API_KEY on purpose: it is sent to
# whatever LOCAL_API_BASE points at, so never put your Anthropic key here.
LOCAL_API_KEY=
LOCAL_MODEL=
