# Copy to .env and fill in. .env is gitignored - never commit your key.

ANTHROPIC_API_KEY=

# Model used across labs 2-8. Sonnet is the sensible default for a workshop:
# capable enough for multi-step tool use, cheap enough not to think about it.
# Check https://platform.claude.com/docs for current model IDs.
WORKSHOP_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Local model server (labs 1 and 2b). The labs auto-detect which is running.
# ---------------------------------------------------------------------------

# llama.cpp / llama-server - the host's GPU machine.
# This is whatever port your start script uses.
LOCAL_API_BASE=http://localhost:8080

# Ollama - more likely on the friends' laptops. Only used if nothing is
# listening at LOCAL_API_BASE.
OLLAMA_HOST=http://localhost:11434
LOCAL_MODEL_SMALL=llama3.2:3b
LOCAL_MODEL_MID=qwen3:8b
LOCAL_MODEL_LARGE=qwen3:14b
